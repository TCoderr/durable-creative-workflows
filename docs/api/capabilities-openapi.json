          "objective": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 15,
            "title": "Objective"
          },
          "audience": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Audience"
          },
          "constraints": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Constraints"
          },
          "prohibited": {
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Prohibited"
          },
          "brand_memory": {
