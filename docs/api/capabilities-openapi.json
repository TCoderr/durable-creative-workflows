{
  "openapi": "3.1.1",
  "info": {
    "title": "VELIN capability service",
    "version": "1.0.0",
    "description": "Private stateless capability service. Only control-plane activities call this API. No database credentials, durable state mutation, approval, arbitrary network tools or browser CORS. Successful output is a proposal plus checks; failed mandatory checks may be returned with 200 and must block production in the control plane. live:false is a fixture."
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Process is alive or initialized.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Process is alive or initialized.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Initialization incomplete.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "not_ready",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Authenticated Prometheus exposition.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Service authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities/run": {
      "post": {
        "summary": "Run",
        "operationId": "run_v1_capabilities_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapabilityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid schema/prompt/tool request, permanent provider failure, or exhausted structured repair.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid internal bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          },
          "403": {
            "description": "Fault injection disabled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          },
          "429": {
            "description": "Capability concurrency limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          },
          "503": {
            "description": "Provider/tool unavailable, circuit open, or capability deadline exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          },
          "500": {
            "description": "Sanitized internal fault.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityError"
                }
              }
            }
          }
        },
        "description": "128 KiB request limit; 16 concurrent calls; 45 s overall deadline. Up to 2 attempts per approved provider, 10 s HTTP timeout, one schema repair. Tools are allowlisted and read-only. The same step_id may execute again after a crash: durable deduplication is the control plane's responsibility. Failures carry only safe attempt evidence, never accepted output.",
        "x-max-request-bytes": 131072,
        "parameters": [
          {
            "name": "traceparent",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "W3C trace context."
          },
          {
            "name": "X-Velin-Test-Fault",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "malformed_once",
                "malformed_always",
                "primary_timeout",
                "primary_failure",
                "force_revision",
                "tool_failure",
                "unauthorized_tool",
                "slow_activity",
                "prompt_injection",
                "regressed"
              ]
            },
            "description": "Local fault injection only when VELIN_TEST_MODE=1; forbidden otherwise. Test mode cannot start in APP_ENV=production."
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Brief": {
