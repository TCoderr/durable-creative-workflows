              "brief",
              "research",
              "strategy",
              "art_direction",
              "typography",
              "motion",
              "imagery",
              "critique",
              "revision"
            ],
            "title": "Capability"
          },
          "brief": {
            "$ref": "#/components/schemas/Brief"
          },
          "context": {
            "type": "object",
            "properties": {
              "brief": {
                "$ref": "#/components/schemas/BriefAnalysis"
              },
              "research": {
                "$ref": "#/components/schemas/Research"
              },
              "strategy": {
                "$ref": "#/components/schemas/Strategy"
              },
              "art_direction": {
                "$ref": "#/components/schemas/CreativeDirection"
              },
              "typography": {
                "$ref": "#/components/schemas/Specialty"
              },
              "motion": {
                "$ref": "#/components/schemas/Specialty"
              },
              "imagery": {
                "$ref": "#/components/schemas/Specialty"
              },
              "critique": {
                "$ref": "#/components/schemas/Critique"
              },
              "revision": {
                "$ref": "#/components/schemas/CreativeDirection"
              },
              "human_decision": {
                "$ref": "#/components/schemas/HumanDecision"
              },
              "review_round": {
                "type": "integer"
              }
            },
            "required": [],
            "additionalProperties": false,
            "description": "Only relevant prior results; serialized UTF-8 limit 64 KiB.",
            "x-max-json-utf8-bytes": 65536
          },
          "revision": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Revision",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "step_id",
          "commission_id",
          "capability",
          "brief"
        ],
        "title": "CapabilityRequest"
      },
      "CapabilityResponse": {
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,128}$",
