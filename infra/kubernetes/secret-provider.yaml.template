# One scoped SecretProviderClass per workload. Render real IDs/names only in an
# operator-approved deployment environment. Never put secret values in Git.
#
# The rendered Secret `velin-${WORKLOAD}-secrets` is consumed through `envFrom`,
# so every key below must exist as a Key Vault object and be listed in both
# `objects` and `secretObjects` for that workload before replicas > 0:
#   api           DATABASE_URL, OIDC_ISSUER, OIDC_AUDIENCE, NATS_URL, CAPABILITIES_TOKEN
#   worker        DATABASE_URL, NATS_URL, CAPABILITIES_TOKEN
#   capabilities  CAPABILITIES_TOKEN, LLM_ENDPOINT (https), LLM_API_KEY, LLM_MODEL,
#                 optionally LLM_FALLBACK_ENDPOINT, LLM_FALLBACK_API_KEY, LLM_FALLBACK_MODEL
# The capability service refuses to start with VELIN_PROVIDER=http when the
# endpoint, key or model is missing. Temporal mTLS material is mounted as files at
# the TEMPORAL_TLS_CERT and TEMPORAL_TLS_KEY paths named in the ConfigMap.
apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: velin-${WORKLOAD}-vault
  namespace: velin-${ENVIRONMENT}
spec:
  provider: azure
  parameters:
    usePodIdentity: "false"
    clientID: ${WORKLOAD_CLIENT_ID}
    keyvaultName: ${KEY_VAULT_NAME}
    tenantId: ${TENANT_ID}
    objects: |
      array:
        - |
          objectName: velin-${WORKLOAD}-service-token
          objectType: secret
  secretObjects:
    - secretName: velin-${WORKLOAD}-secrets
      type: Opaque
      data:
        - objectName: velin-${WORKLOAD}-service-token
          key: CAPABILITIES_TOKEN
