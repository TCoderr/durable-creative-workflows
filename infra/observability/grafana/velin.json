{
  "title": "VELIN · Durable creative workflows",
  "uid": "velin-runtime",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "velin"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Workflow outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "velin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(velin_workflow_outcomes_total[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "velin-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active workflows (Temporal visibility)",
      "datasource": {
        "type": "prometheus",
        "uid": "velin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(velin_workflows_active)",
          "datasource": {
            "type": "prometheus",
            "uid": "velin-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Workflow duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "velin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (outcome, le) (rate(velin_workflow_duration_seconds_bucket[1h])))",
          "datasource": {
            "type": "prometheus",
            "uid": "velin-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
