# Documentation only. Generate real local values with `npm run local:env`.
# Never put production credentials in this file or in frontend VITE_* variables.
APP_ENV=development
APP_VERSION=local
HTTP_ADDR=:8080
WORKER_HTTP_ADDR=:8081
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=velin-commissions
CAPABILITIES_URL=http://127.0.0.1:18000
VELIN_PROVIDER=deterministic
VELIN_TEST_MODE=1
ARTIFACT_ROOT=.local/artifacts
REVIEW_TIMEOUT=168h
# Required injected secrets: DATABASE_URL, CAPABILITIES_TOKEN, VELIN_API_KEYS, NATS_URL
# Production: OIDC_ISSUER, OIDC_AUDIENCE, TEMPORAL_TLS_CERT, TEMPORAL_TLS_KEY,
# AZURE_BLOB_ENDPOINT, AZURE_BLOB_CONTAINER, DATABASE_AUTH=azure,
# DATABASE_URL with sslmode=verify-full and a provisioned Entra principal.
# Live capabilities: VELIN_PROVIDER=http, LLM_ENDPOINT, LLM_MODEL, LLM_API_KEY;
# optional LLM_FALLBACK_ENDPOINT, LLM_FALLBACK_MODEL, LLM_FALLBACK_API_KEY.
# Frontend production server: HOST, PORT, API_UPSTREAM (server-side only).
